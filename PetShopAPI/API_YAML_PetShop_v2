openapi: 3.0.0
info:
  title: API сервиса Lucky Insurance
  description: >-
    Коллекция запросов API сервиса. Сервис предоставляет информацию об страховках для животных
  version: 1.0.1
  contact:
    name: LuckyFilms API
    url: https://lucky.com/info
    email: LuckyFilms@lucky.com
  termsOfService: https://lucky.com/terms
  license:
    name: license 1.0.1 Lucky
    url: https://lucky.com/license
servers:
  - url: https://4453f729-1913-49be-9dcc-b7a316afa17f.mock.pstmn.io
    description: базовый путь к сервису страховок без эндпоинта
tags:
  - name: Insurance Server API
paths:
  /insurance:
    get:
      tags:
        - Insurance Server API
      summary: Описание всех страховок для животных
      description: Просмотр детального описания страховок по виду животного.
      operationId: insuranceList
      responses:
        '200':
          description: список страховок
          content:
            application/json:
              schema:
                properties:
                  description: 
                    type: string
                    description: Уровень услуг
                    example: Помощь ветеринара 24/7. Онлайн консультации. Большой выбор ветклиник.
                  insurances:
                    type: array
                    items:
                          $ref: '#/components/schemas/response_200'
        '400':
          description: Bad request. Отправлен некорректный запрос серверу. Необходимо проверить параметры запроса.
        '404':
          description: Not found. Запрашиваемый ресурс не найден. Необходимо проверить корректность URL.
        '405':
          description: Method not allowed. Метод не поддерживается. Необходимо проверить корректность URL и тип метода.
        '500':
          description: Internal server error. Ошибка сервера. Измените параметры запроса или попробуйте отправить запрос позже.
        '502':
          description: Bad gateway. Не запущены компоненты сервера. Подождите минуту и отправьте запрос повторно.
components:
  schemas:
    response_200:
      required:
        - type
        - details
        - price
        - currency
        - period
      type: object
      properties:
        type: 
          type: string
          description: вид страхуемого животного
          example: кошка
          enum:
            - кошка
            - собака
        details:
          type: string
          description: описание условий страховки 
          example: Круглосуточные консультации ветеринарного врача по телефону, в чате или видеосвязи. Включена ежегодная вакцинация от бешенства.
        price:
          type: integer
          description: Стоимость страховки за период
          example: 50000
        currency:
          type: string
          description: Валюта оплаты
          example: 'рублей'
        period:
          type: string
          description: Период страхования
          example: 'в год'
